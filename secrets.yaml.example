# ==============================================================================
# SECRETS TEMPLATE - HOME ASSISTANT PRODUCTION SETUP
# ==============================================================================
# COPY THIS FILE TO 'secrets.yaml' AND FILL IN YOUR ACTUAL ENVIRONMENT DATA.
# DO NOT COMMIT THE ACTUAL 'secrets.yaml' FILE TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# Industrial IoT / Modbus Infrastructure
# ------------------------------------------------------------------------------
# Waveshare RS485-to-Ethernet (Type B) Gateway
heat_pump_gateway_host: 192.168.10.150
heat_pump_gateway_port: 502
heat_pump_slave_id: 1

# Huawei SUN2000 Inverter (SDongleA-05 Modbus TCP)
huawei_inverter_host: 192.168.10.160
huawei_inverter_port: 502
huawei_inverter_slave_id: 1

# ------------------------------------------------------------------------------
# Network & Subnet Segmentation (OPNsense / VLANs)
# ------------------------------------------------------------------------------
iot_vlan_gateway: 192.168.10.1
trusted_lan_gateway: 192.168.1.1

# ------------------------------------------------------------------------------
# Grid & Utility Integrations (Tauron G12/G12w)
# ------------------------------------------------------------------------------
tauron_api_token: "YOUR_TAURON_API_TOKEN_HERE"
tauron_meter_id: "1234567890"

# ------------------------------------------------------------------------------
# Notifications & Alerting (e.g. Telegram / Pushover / Discord)
# ------------------------------------------------------------------------------
notify_telegram_bot_token: "123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
notify_telegram_chat_id: "-1001234567890"